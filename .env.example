APP_ENV=development

MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
DATABASE_URL=postgresql+psycopg://researchmate:local-dev-password@127.0.0.1:5432/researchmate

# Optional Agent limits. GLM-5.3-Flash thinking remains enabled.
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_TOKENS=4096
AGENT_TIMEOUT_SECONDS=300

# Optional image-capable model ID on the same MODEL_BASE_URL / MODEL_API_KEY.
# Leave blank to keep screenshot input disabled. Restart backend after changes.
RELATIONSHIP_VISION_MODEL=glm-5.3-flashx
# Optional: use another provider for screenshots, otherwise reuse MODEL_*.
RELATIONSHIP_VISION_BASE_URL=
RELATIONSHIP_VISION_API_KEY=
