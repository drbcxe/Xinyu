APP_ENV=development

MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
DATABASE_URL=postgresql+psycopg://researchmate:local-dev-password@127.0.0.1:5432/researchmate
REDIS_URL=redis://127.0.0.1:6379/1
# Allowed browser origins for account mutations. Never use * with cookies.
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Optional Agent limits. GLM-5.3-Flash thinking remains enabled.
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_TOKENS=4096
AGENT_TIMEOUT_SECONDS=300

# Local embedding: no new API key. Keep downloads/cache on D:.
QDRANT_URL=http://127.0.0.1:6333
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_MODEL_CACHE=D:/DevTools/embedding-models
RAG_RERANK_ENABLED=true

# Optional image-capable model ID on the same MODEL_BASE_URL / MODEL_API_KEY.
# Leave blank to keep screenshot input disabled. Restart backend after changes.
RELATIONSHIP_VISION_MODEL=glm-5.3-flashx
# Optional: use another provider for screenshots, otherwise reuse MODEL_*.
RELATIONSHIP_VISION_BASE_URL=
RELATIONSHIP_VISION_API_KEY=

# Optional verified email / password recovery. Fill secrets only in your local .env.
# STARTTLS usually uses 587; implicit SSL usually uses 465. Follow your SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=10

# Durable daily quotas (UTC reset). All model HTTP attempts, including retries and rerank, are accounted.
GUEST_DAILY_REQUESTS=8
ACCOUNT_DAILY_REQUESTS=100
GUEST_DAILY_TOKENS=120000
ACCOUNT_DAILY_TOKENS=1500000
GLOBAL_DAILY_TOKENS=10000000
GLOBAL_DAILY_REQUESTS=2000
IP_DAILY_REQUESTS=300
GLOBAL_MODEL_CONCURRENCY=4
GLOBAL_QUEUE_LIMIT=100
OWNER_PENDING_LIMIT=2
OWNER_STORAGE_BYTES=20971520
OWNER_ITEM_LIMIT=500
GLOBAL_STORAGE_BYTES=536870912
GLOBAL_ITEM_LIMIT=20000
# Atomic logical PostgreSQL row budgets include graph state, history, jobs and metadata.
# Reserve must cover graph + result + 131072 bytes. Physical disk/vector limits are separate.
GRAPH_THREAD_STORAGE_BYTES=4194304
AGENT_RESULT_BYTES=1048576
JOB_STORAGE_RESERVE_BYTES=6291456
GLOBAL_PROFILE_LIMIT=10000
STORAGE_EMERGENCY_BYTES=65536
MODEL_CALL_INPUT_LIMIT=60000
MODEL_BUDGET_PER_REQUEST=160000
MODEL_CALLS_PER_REQUEST=24
# Conservative image budget reserve, not a tokenizer or a currency price.
MODEL_IMAGE_TOKEN_RESERVE=16000
WORKER_ADVICE_CONCURRENCY=2
WORKER_LEASE_SECONDS=90
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=5

# Local ops CLI auto-creates a private key under .runtime/secrets; never expose it in frontend.
# Production requires an explicit random OPS_TOKEN with at least 32 characters.
OPS_TOKEN=
DATABASE_CONNECT_TIMEOUT=5
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Separate 32-byte backup master key. Local default: .runtime/backup-keys/master.key (D drive).
# Keep a private independent copy; never place this key inside the backup folder or Git.
BACKUP_KEY_FILE=

# Process-local retrieval reuse. Estimates are cache-accounting bytes, not OS RSS limits.
RAG_CACHE_BYTES=67108864
RAG_CACHE_ENTRIES=8
RAG_CACHE_TTL_SECONDS=120
